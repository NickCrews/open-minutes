# Which database to target: a name ("local", "prod", ...) resolved via
# DATABASE_URL_<NAME> below, or a full postgres:// URL used verbatim.
# Usually passed per-command, e.g. `DB=prod pnpm db migrate`.
#
# "local" (the default) needs no configuration: it targets docker-compose's
# postgres, in a database per git branch (open_minutes__<branch>, e.g.
# open_minutes__main; open_minutes__detached_<commit> on a detached HEAD).
# To use one database on every branch, point DB at it here:
#DB=postgres://postgres:postgres@localhost:5432/open_minutes__main

#DATABASE_URL_PROD=postgres://user:password@host/dbname?sslmode=require

NODE_ENV=development

# The blob store: the project's public, S3-compatible bucket of blobs
# (Cloudflare R2), used for storing recording audio and large files.
# The keys are for writing.
# The web app reads the public URL from its own config instead
# (packages/web/wrangler.jsonc).
BLOB_STORE_PUBLIC_URL=https://pub-ac21478ae97547c5a797c710cdc9df3d.r2.dev
BLOB_STORE_ENDPOINT=https://9d0e65e8801b8e953ee7cb4c3e840ae8.r2.cloudflarestorage.com
BLOB_STORE_BUCKET=open-minutes
BLOB_STORE_ACCESS_KEY_ID=...
BLOB_STORE_SECRET_ACCESS_KEY=...

# When running in a environment that doesn't allow yt-dlp to fetch videos locally,
# We can fall back to triggering the fetch-youtube-audio GitHub workflow instead,
# Triggering this workflow, and reading its published artifacts, requires a
# GitHub token allowed to run the fetch-youtube-audio workflow and read its
# artifacts (a fine-grained token with Actions: write on the repo).
#YOUTUBE_AUDIO_DISPATCH_TOKEN=github_pat_...

# The routes yt-dlp tries, in order, when YouTube refuses the one before
# ("sign in to confirm you're not a bot"): direct, warp, tor (started by
# packages/ytdlp), or a proxy URL used as is. Only used when yt-dlp fetches a
# video locally. Default direct,warp,tor. See packages/ytdlp/README.md.
#YOUTUBE_EGRESS=direct,socks5://127.0.0.1:9050
