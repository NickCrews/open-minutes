# Which database to target: a name ("local", "prod", ...) resolved via
# DATABASE_URL_<NAME> below, or a full postgres:// URL used verbatim.
# Usually passed per-command, e.g. `DB=prod pnpm db migrate`.
#
# "local" (the default) needs no configuration: it targets docker-compose's
# postgres, in a database per git branch (open_minutes__<branch>, e.g.
# open_minutes__main; open_minutes__detached_<commit> on a detached HEAD).
# To use one database on every branch, point DB at it here:
#DB=postgres://postgres:postgres@localhost:5432/open_minutes__main

#DATABASE_URL_PROD=postgres://user:password@host/dbname?sslmode=require

NODE_ENV=development

# The object store: the project's public, S3-compatible bucket of blobs
# (Cloudflare R2), one top-level prefix per kind. YouTube metadata and audio
# are read from youtube/<video id>/ here first; the fetch-youtube-audio workflow
# fills it. Reading needs only the public URL; the keys are for writing.
# The web app plays excerpts' audio from the public URL too (baked into builds;
# without it, excerpts play through YouTube embeds).
#OBJECT_STORE_PUBLIC_URL=https://pub-<hash>.r2.dev
OBJECT_STORE_ENDPOINT=https://9d0e65e8801b8e953ee7cb4c3e840ae8.r2.cloudflarestorage.com
OBJECT_STORE_BUCKET=open-minutes
OBJECT_STORE_ACCESS_KEY_ID=...
OBJECT_STORE_SECRET_ACCESS_KEY=...

# A GitHub token allowed to run the fetch-youtube-audio workflow (a fine-grained token
# with Actions: write on the repo). With it, a video missing from the store is
# stored by that workflow; without it, it's fetched locally with yt-dlp.
#YOUTUBE_AUDIO_DISPATCH_TOKEN=github_pat_...

# A Netscape-format cookies.txt from a browser signed in to YouTube, passed to
# yt-dlp. Only needed where YouTube makes yt-dlp "sign in to confirm you're not
# a bot", which it does to datacenter IPs (servers, CI). Use a throwaway
# account: YouTube may ban accounts used this way. See
# https://github.com/yt-dlp/yt-dlp/wiki/Extractors#exporting-youtube-cookies
#YOUTUBE_COOKIES=/path/to/youtube-cookies.txt
