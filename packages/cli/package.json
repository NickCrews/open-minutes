{
  "name": "@open-minutes/cli",
  "version": "0.1.0",
  "description": "The om CLI for development: list, find and ingest meetings, and download models. A thin wrapper over @open-minutes/ingest and @open-minutes/audio",
  "type": "module",
  "bin": {
    "om": "./src/om.ts"
  },
  "scripts": {
    "om": "tsx src/om.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-minutes/audio": "workspace:*",
    "@open-minutes/core": "workspace:*",
    "@open-minutes/db": "workspace:*",
    "@open-minutes/ingest": "workspace:*",
    "citty": "^0.1.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0"
  }
}
