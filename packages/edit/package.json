{
  "name": "@open-minutes/edit",
  "version": "0.1.0",
  "description": "Edit a meeting's transcript, people and chapters in a database, and move golden meetings between a database and the datums",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
