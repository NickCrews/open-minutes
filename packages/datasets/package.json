{
  "name": "@open-minutes/datasets",
  "version": "0.1.0",
  "description": "Open Minutes test data: golden jurisdictions, bodies, people and meetings, the datasets that select from them, and the tools that load and check them",
  "type": "module",
  "exports": {
    ".": "./src/datasets.ts",
    "./datums": "./src/datums.ts",
    "./psv": "./src/psv.ts",
    "./audio": "./src/audio.ts",
    "./clips": "./src/clips.ts",
    "./fix": "./src/fix.ts",
    "./check": "./src/check.ts"
  },
  "scripts": {
    "check": "vpx src/check-cli.ts",
    "fix": "vpx src/fix-cli.ts",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-minutes/core": "workspace:*",
    "@open-minutes/meeting-audio": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  }
}
