{
  "name": "@open-minutes/db",
  "version": "0.1.0",
  "description": "Open Minutes database: schema, migrations, connections, and test databases",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./resolve": "./src/resolve.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/vitest": "./src/testing/vitest.ts",
    "./ensure": "./src/ensure.ts",
    "./config": "./src/config.ts"
  },
  "bin": {
    "dbranch": "./src/cli.ts"
  },
  "scripts": {
    "db": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-minutes/core": "workspace:*",
    "citty": "^0.1.6",
    "drizzle-orm": "1.0.0-beta.21",
    "postgres": "^3"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "drizzle-kit": "1.0.0-beta.22",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
