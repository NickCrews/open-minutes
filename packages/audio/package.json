{
  "name": "@open-minutes/audio",
  "version": "0.1.0",
  "description": "Open Minutes speech processing: transcribe, diarize and embed meeting audio with local ONNX models",
  "type": "module",
  "exports": {
    "./transcribe": "./src/transcribe.ts",
    "./diarize": "./src/diarize.ts",
    "./embed": "./src/embed.ts",
    "./embed-model": "./src/embed-model.ts",
    "./models": "./src/all-models.ts",
    "./vad": "./src/vad.ts",
    "./span": "./src/span.ts",
    "./coverage": "./src/coverage.ts",
    "./wav": "./src/wav.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "vitest bench --run",
    "models": "tsx src/models-cli.ts"
  },
  "dependencies": {
    "@open-minutes/codecs": "workspace:*",
    "@open-minutes/core": "workspace:*",
    "sherpa-onnx-node": "^1.12.39"
  },
  "devDependencies": {
    "@open-minutes/fixtures": "workspace:*",
    "@types/node": "^22.19.17",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
