{
  "name": "@open-minutes/pipeline",
  "version": "0.1.0",
  "description": "Open Minutes pipeline: discover meetings, add them to the database, and turn their audio into transcripts with @open-minutes/audio, one function per step",
  "type": "module",
  "bin": {
    "om": "./src/cli/om.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "om": "tsx src/cli/om.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@open-minutes/akleg": "workspace:*",
    "@open-minutes/audio": "workspace:*",
    "@open-minutes/core": "workspace:*",
    "@open-minutes/db": "workspace:*",
    "@open-minutes/youtube": "workspace:*",
    "citty": "^0.1.6",
    "drizzle-orm": "1.0.0-beta.21"
  },
  "devDependencies": {
    "@open-minutes/fixtures": "workspace:*",
    "@types/node": "^22.19.17",
    "tsx": "^4.21.0"
  }
}
