{
  "name": "@open-minutes/tools",
  "version": "0.1.0",
  "description": "Open Minutes data-editing tools for agents: a typed tool list and a JSON CLI over the database",
  "type": "module",
  "bin": {
    "om-tools": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "tools": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-minutes/core": "workspace:*",
    "@open-minutes/db": "workspace:*",
    "drizzle-orm": "1.0.0-beta.21",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@open-minutes/fixtures": "workspace:*",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
