    "changeset": "vpx src/cli.ts",
    "test": "vp test run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@open-minutes/core": "workspace:*",
    "@open-minutes/db": "workspace:*",
    "@open-minutes/edit": "workspace:*",
    "citty": "^0.1.6",
    "drizzle-orm": "1.0.0-beta.21"
  },
  "devDependencies": {
    "@open-minutes/seed": "workspace:*",
    "@types/node": "catalog:",
    "vite-plus": "catalog:"
  }
}
