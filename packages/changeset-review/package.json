{
  "name": "@open-minutes/changeset-review",
  "version": "0.1.0",
  "description": "Review changesets in GitHub issues: show what each statement does as a page, and propose, revise, review and apply versions of a changeset",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./build": "./src/build.ts",
    "./client.js": "./src/client.js"
  },
