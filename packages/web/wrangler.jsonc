{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "open-minutes",
  "compatibility_date": "2026-07-19",
  // nodejs_compat also populates process.env from vars/secrets (the
  // nodejs_compat_populate_process_env flag, default-on at this date), which
  // is how DATABASE_URL reaches the db resolution code.
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/solid-start/server-entry",
  "observability": { "enabled": true },
  // Plain (non-secret) configuration, the same in dev, previews and
  // production; secrets like DATABASE_URL are set elsewhere. The app reads
  // both from process.env in src/server/config.ts.
  "vars": {
    // The object store's public base URL (OBJECT_STORE_PUBLIC_URL in
    // .env.example). Excerpts play audio from it.
    "OBJECT_STORE_PUBLIC_URL": "https://pub-ac21478ae97547c5a797c710cdc9df3d.r2.dev",
  },
}
