{
  "name": "root",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm db up && pnpm web:dev",
    "format": "prettier --experimental-cli --ignore-unknown '**/*' --write",
    "format:check": "prettier --experimental-cli --ignore-unknown '**/*' --check",
    "lint": "eslint .",
    "test": "vitest run",
    "test:slow": "SLOW=1 vitest run --tagsFilter slow",
    "test:ytdlp": "YTDLP=1 vitest run --tagsFilter ytdlp",
    "test:all": "SLOW=1 YTDLP=1 vitest run",
    "bench": "vitest bench --run",
    "typecheck": "pnpm --filter @open-minutes/* run typecheck",
    "check": "pnpm typecheck && pnpm run format:check && pnpm run lint && pnpm run test",
    "web:dev": "pnpm --filter @open-minutes/web run dev",
    "db": "pnpm --silent --filter @open-minutes/db run db",
    "models": "pnpm --silent --filter @open-minutes/audio run models",
    "fixtures:check": "pnpm --silent --filter @open-minutes/fixtures run check",
    "fixtures:fix": "pnpm --silent --filter @open-minutes/fixtures run fix",
    "deploy:prod": "pnpm --filter @open-minutes/web run deploy"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@open-minutes/datasets": "workspace:*",
    "@open-minutes/db": "workspace:*",
    "@open-minutes/fixtures": "workspace:*",
    "@open-minutes/ytdlp": "workspace:*",
    "@types/node": "^22",
    "eslint": "^9.36.0",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.45.0",
    "vitest": "^4.0.18"
  }
}
