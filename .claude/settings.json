{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && pnpm -s datasets:check --hook",
            "timeout": 60,
            "statusMessage": "Checking fixture data"
          }
        ]
      }
    ]
  }
}
